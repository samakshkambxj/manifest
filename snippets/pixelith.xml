<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- PixelithOS: Lineage 24.0 base kept, GMS only from Clover -->
  <remote name="pixelith" fetch="https://github.com/samakshkambxj" revision="lineage-24.0" />
  <remote name="clover" fetch="https://github.com/The-Clover-Project" revision="17" />
  <remote name="clover-gitlab" fetch="https://gitlab.com/thecloverproject" revision="17" />

  <!-- vendor/lineage override: only partner_gms.mk changed to inherit Clover GMS -->
  <remove-project name="LineageOS/android_vendor_lineage" />
  <project path="vendor/lineage" name="android_vendor_lineage" remote="pixelith" />

  <!-- frameworks/base override: PixelProps patch (Evo port) lives here -->
  <remove-project name="LineageOS/android_frameworks_base" />
  <project path="frameworks/base" name="android_frameworks_base" remote="pixelith" groups="pdk-cw-fs,pdk-fs,sysui-studio" />

  <project path="vendor/pixel/gms" name="vendor_pixel_gms_17" remote="clover-gitlab" clone-depth="1" />
  <project path="vendor/pixel/launcher" name="vendor_pixel_launcher" remote="clover-gitlab" clone-depth="1" />
  <project path="vendor/pixel/sounds" name="vendor_pixel_sounds" remote="clover-gitlab" clone-depth="1" />
  <project path="vendor/pixel/themepicker" name="vendor_pixel_themepicker" remote="clover-gitlab" clone-depth="1" />
  <project path="vendor/pixel/extract-utils" name="vendor_pixel_extract-utils" remote="clover-gitlab" />
</manifest>
